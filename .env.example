# DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/nest_db?schema=public"
# postgres — имя пользователя БД (по умолчанию)
# your_password — пароль от вашего PostgreSQL (замените на реальный!)
# localhost:5432 — адрес и порт (5432 — стандартный для Postgres)
# nest_db — имя вашей базы данных (создайте её заранее через pgAdmin или командой CREATE DATABASE nest_db; в psql)